{
  "info": {
    "name": "Dokumente – Rolf 2026-07-01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseURL",
      "value": "http://localhost/ratioserver"
    }
  ],
  "item": [
    {
      "name": "Dokumente",
      "item": [
        {
          "name": "demo",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/dokumente/demo?id=1&filter=test",
              "host": ["{{baseURL}}"],
              "path": ["dokumente", "demo"],
              "query": [{ "key": "id", "value": "1" }, { "key": "filter", "value": "test" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beispiel\",\n  \"menge\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Demo-Endpunkt des Dokumente-Controllers."
          },
          "response": []
        },
        {
          "name": "getVorlagen",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/getvorlagen", "host": ["{{baseURL}}"], "path": ["dokumente", "getvorlagen"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\"nr\", \"name\", \"art\", \"bereich\", \"dokkategorie\"],\n  \"orderby\": \"name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Alle Vorlagen abrufen. fields: Liste der gewünschten Felder oder \"*\"."
          },
          "response": []
        },
        {
          "name": "getVorlagenFiltered",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/getvorlagenfiltered", "host": ["{{baseURL}}"], "path": ["dokumente", "getvorlagenfiltered"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": \"*\",\n  \"art\": \"BRIEF\",\n  \"bereich\": \"EINGANG\",\n  \"orderby\": \"name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Vorlagen mit optionalen Filtern: art, name, bereich, doktyp, dokkategorie, archiv, versteckt, reftable, refnr, mandant."
          },
          "response": []
        },
        {
          "name": "getVorlagenById",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/getvorlagenbyid", "host": ["{{baseURL}}"], "path": ["dokumente", "getvorlagenbyid"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nr\": 1,\n  \"fields\": \"*\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Eine Vorlage per Primärschlüssel (nr) abrufen."
          },
          "response": []
        },
        {
          "name": "getVorlagenKey",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/getvorlagenkey", "host": ["{{baseURL}}"], "path": ["dokumente", "getvorlagenkey"] },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "description": "Nächste freie Nummer aus Generator GEN_ID(VORLAGENNR,1) abrufen."
          },
          "response": []
        },
        {
          "name": "insertVorlagen",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/insertvorlagen", "host": ["{{baseURL}}"], "path": ["dokumente", "insertvorlagen"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nr\": 1,\n  \"name\": \"Mustervorlage\",\n  \"art\": \"BRIEF\",\n  \"standard\": \"J\",\n  \"text1\": \"\",\n  \"text2\": \"\",\n  \"drucker\": \"\",\n  \"druckerwahl\": \"\",\n  \"folgeformular\": null,\n  \"datum\": \"2026-07-01\",\n  \"angepasst\": \"N\",\n  \"bereich\": \"ALLGEMEIN\",\n  \"doktyp\": \"D\",\n  \"versteckt\": \"N\",\n  \"dokkategorie\": \"\",\n  \"geaendertam\": \"2026-07-01\",\n  \"bearbeiter\": \"SUPERVISOR\",\n  \"archiv\": \"N\",\n  \"mandant\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Neue Vorlage anlegen. nr vorher per getVorlagenKey ermitteln."
          },
          "response": []
        },
        {
          "name": "updateVorlagen",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/updatevorlagen", "host": ["{{baseURL}}"], "path": ["dokumente", "updatevorlagen"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nr\": 1,\n  \"name\": \"Geänderte Vorlage\",\n  \"art\": \"BRIEF\",\n  \"geaendertam\": \"2026-07-01\",\n  \"bearbeiter\": \"SUPERVISOR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Vorlage aktualisieren. nr ist der WHERE-Schlüssel."
          },
          "response": []
        },
        {
          "name": "deleteVorlagen",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwttoken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseURL}}/dokumente/deletevorlagen", "host": ["{{baseURL}}"], "path": ["dokumente", "deletevorlagen"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nr\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Vorlage löschen per Primärschlüssel (nr)."
          },
          "response": []
        }
      ]
    }
  ]
}
